table FactSales
	lineageTag: 54495d36-153b-5630-be96-e8072451e848

	/// Signed revenue after discounts; includes return sales.
	measure Revenue = SUM(FactSales[sales_amount])
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Dashboard measures
		lineageTag: 3424b571-82dd-4167-bf55-9af1827c4fd9

	/// Provisional source profit. The 15 return sign inconsistencies have not been corrected.
	measure 'Recorded Profit' = SUM(FactSales[profit])
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Dashboard measures
		lineageTag: 2adcc117-2ed3-4d38-ad33-2e99c6eb7e7f

	/// Distinct order IDs, including return records.
	measure Orders = DISTINCTCOUNT(FactSales[order_id])
		formatString: #,0
		displayFolder: Dashboard measures
		lineageTag: 307e6b6b-0abd-4a65-bb5d-8738859e3c47

	/// Purchasing customers in the current filter context; counted from the fact table.
	measure Customers = DISTINCTCOUNT(FactSales[customer_id])
		formatString: #,0
		displayFolder: Dashboard measures
		lineageTag: 5f8b5d4c-c1c2-42df-9864-01a2feee7e79

	/// Ratio of totals, not average transaction margin.
	measure 'Profit Margin' = DIVIDE([Recorded Profit], [Revenue])
		formatString: 0.00%
		displayFolder: Dashboard measures
		lineageTag: 318d8f96-a268-4284-982a-a881b94a084c

	/// Orders with negative quantity.
	measure 'Return Orders' = CALCULATE([Orders], FactSales[is_return] = TRUE())
		formatString: #,0
		displayFolder: Dashboard measures
		lineageTag: a7fee2a0-e229-4dc5-9cc5-9735553389cb

	/// Blank dates have no dated dimension member.
	measure 'Undated Orders' = CALCULATE([Orders], KEEPFILTERS(ISBLANK(FactSales[date_key])))
		formatString: #,0
		displayFolder: Dashboard measures
		lineageTag: 40113d06-8b6b-4a2a-abd9-489490232f13

	/// Dynamic top ten within the selected year, region and category; ties broken by product name.
	measure 'Top 10 Revenue' =
			VAR TopProducts = TOPN(10, ALLSELECTED(DimProduct[product_name]), [Revenue], DESC, DimProduct[product_name], ASC)
			RETURN IF(CONTAINS(TopProducts, DimProduct[product_name], SELECTEDVALUE(DimProduct[product_name])), [Revenue], BLANK())
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Dashboard measures
		lineageTag: bcb8a643-16eb-4dc7-abc9-0ade94a92e5c

	/// Revenue for dated month points only; excludes unknown date member.
	measure 'Monthly Revenue' = IF(NOT ISBLANK(SELECTEDVALUE(DimDate[month_year])), [Revenue], BLANK())
		formatString: #,0.00;(#,0.00);0.00
		displayFolder: Dashboard measures
		lineageTag: ca20a6e4-cc0e-4ae6-9852-37a343dfc01a

