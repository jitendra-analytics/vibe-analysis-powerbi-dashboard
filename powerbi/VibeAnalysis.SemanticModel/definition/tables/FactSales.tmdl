	partition FactSales = m
		mode: import
		source =
				let
				    Source = Csv.Document(Binary.FromText("", BinaryEncoding.Base64), [Delimiter=",", Columns=16, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				    Typed = Table.TransformColumnTypes(Nulls, {{"order_id", type text}, {"order_date", type date}, {"customer_id", type text}, {"product_id", type text}, {"region_id", type text}, {"quantity", Int64.Type}, {"discount", type number}, {"sales_amount", Currency.Type}, {"cost_amount", Currency.Type}, {"profit", Currency.Type}, {"order_date_raw", type text}, {"invalid_order_date", type logical}, {"missing_customer_id", type logical}, {"missing_product_id", type logical}, {"is_return", type logical}, {"date_key", Int64.Type}}, "en-US")
				in
				    Typed

